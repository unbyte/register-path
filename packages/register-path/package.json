{
  "name": "register-path",
  "version": "0.0.1",
  "description": "Persist a directory in the current user's PATH across Unix shells and Windows.",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "lib"
  ],
  "homepage": "https://github.com/unbyte/register-path#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unbyte/register-path.git",
    "directory": "packages/register-path"
  },
  "bugs": {
    "url": "https://github.com/unbyte/register-path/issues"
  },
  "author": {
    "name": "unbyte",
    "url": "https://github.com/unbyte"
  },
  "license": "MIT",
  "keywords": [
    "path",
    "environment",
    "shell",
    "windows",
    "installer"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "turbo run build"
  },
  "publishConfig": {
    "access": "public",
    "main": "lib/index.cjs",
    "module": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./lib/index.d.ts",
          "default": "./lib/index.js"
        },
        "require": {
          "types": "./lib/index.d.cts",
          "default": "./lib/index.cjs"
        }
      }
    }
  }
}
